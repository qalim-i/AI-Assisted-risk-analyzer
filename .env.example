# Copy this file to .env and select one provider configuration below.

# Local Ollama
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI (uncomment and set a key instead of the Ollama values above)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=paste-your-key-here
# OPENAI_BASE_URL=https://your-provider.example/v1
